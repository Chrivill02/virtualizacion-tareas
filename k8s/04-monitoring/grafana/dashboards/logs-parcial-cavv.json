  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "app",
          "stream": "{namespace=\"parcial-cavv\"}",
          "type": 1,
          "refId": "app"
        },
        "definition": "label_values({namespace=\"parcial-cavv\"}, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "buscar",
        "label": "Buscar texto",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Lineas de log por app (parcial-cavv)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "legendFormat": "{{app}}",
          "expr": "sum by (app) (count_over_time({namespace=\"parcial-cavv\", app=~\"$app\"} |~ \"(?i)$buscar\" [1m]))"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
