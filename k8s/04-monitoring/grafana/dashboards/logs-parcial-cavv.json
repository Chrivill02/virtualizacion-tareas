{
  "uid": "logs-parcial-cavv",
  "title": "Logs - Apps de parcial-cavv (Loki)",
  "tags": [
    "cavv",
    "loki",
    "logs"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
